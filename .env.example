# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local para desarrollo.
# En producción, configura estas variables en Vercel:
#   Project → Settings → Environment Variables
# (o con la integración de Supabase en Vercel Marketplace, que
#  crea SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY automáticamente)
# Ninguna lleva NEXT_PUBLIC_: nunca se exponen al navegador.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (enlaces de los correos, sitemap, robots)
SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (permiso "Full access" para gestionar contactos)
RESEND_API_KEY=
# Resend → Audience → Segments (opcional: sincroniza contactos confirmados)
RESEND_SEGMENT_ID=
# Remitente: requiere dominio verificado en Resend.
# Sin dominio, onboarding@resend.dev solo entrega a tu propio correo.
EMAIL_FROM="rafatrujillo <hola@rafatrujillo.xyz>"
EMAIL_REPLY_TO=

# Sal para el hash de IP (rate limit). Genera una: openssl rand -hex 32
IP_HASH_SALT=

# Vercel Cron la envía como "Authorization: Bearer ..." (openssl rand -hex 32)
CRON_SECRET=

# Panel /admin (usuario: admin). Genera una: openssl rand -base64 18
ADMIN_PASSWORD=
# Correo que recibe los mensajes del formulario de booking/prensa
CONTACT_EMAIL=
